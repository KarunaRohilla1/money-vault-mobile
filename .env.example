# Development example:
# Prefer npm scripts instead of editing this by hand:
#   npm run api:url:device     # physical phone on LAN
#   npm run api:url:emulator   # Android emulator -> http://10.0.2.2:8001
#   npm run api:url:simulator  # iOS simulator -> http://127.0.0.1:8001
#   npm run start:local
APP_ENV=development
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8001
