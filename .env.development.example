# Development / lower environments
#
# Physical device (same Wi-Fi as your PC):
#   npm run api:url:device
# Android emulator:
#   npm run api:url:emulator   -> http://10.0.2.2:8001
# iOS simulator:
#   npm run api:url:simulator  -> http://127.0.0.1:8001
#
# Then start the local API in money-vault:
#   python scripts/run_api_local.py
# and start Expo with:
#   npm run start:local
#
APP_ENV=development
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8001
